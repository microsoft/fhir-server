@baseUrl = https://localhost:44348

# VECTOR-AWARE SYSTEM REINDEX PROOF
#
# Run requests in order. The Observation is written before the unique vector
# SearchParameter exists. A successful final search, with an unchanged resource
# version, proves that system $reindex generated and persisted its vector rows.

# @name bearer
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
&client_id=globalAdminServicePrincipal
&client_secret=globalAdminServicePrincipal
&scope=fhir-api

###

# 1. Create the resource before defining the semantic search code.
# @name putProofObservation
PUT {{baseUrl}}/Observation/demo-reindex-proof-observation
Content-Type: application/fhir+json
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

{
  "resourceType": "Observation",
  "id": "demo-reindex-proof-observation",
  "status": "final",
  "code": {
    "text": "Vector reindex proof narrative"
  },
  "subject": {
    "reference": "Patient/8f789d0b-3145-4cf2-8504-13159edaa747"
  },
  "effectiveDateTime": "2025-02-04T09:30:00Z",
  "note": [
    {
      "text": "After standing in a warm crowded room, the patient developed tunnel vision and leg weakness but remained conscious. Symptoms resolved after lying flat."
    }
  ]
}

###

# 2. Create a unique SearchParameter after the Observation write. REST Client
# evaluates each {{$guid}} independently; the response captures the generated
# canonical and code for subsequent requests.
# @name createProofSearchParameter
POST {{baseUrl}}/SearchParameter
Content-Type: application/fhir+json
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

{
  "resourceType": "SearchParameter",
  "url": "https://example.org/fhir/SearchParameter/demo-reindex-proof-{{$guid}}",
  "version": "1.0.0",
  "name": "DemoVectorReindexProof",
  "status": "active",
  "experimental": true,
  "publisher": "Microsoft FHIR Server semantic search demo",
  "description": "Proves that system reindex backfills semantic vectors for an Observation created before this definition exists.",
  "code": "demo-reindex-proof-{{$guid}}",
  "base": [
    "Observation"
  ],
  "type": "special",
  "expression": "Observation.note.text",
  "extension": [
    {
      "url": "http://microsoft.com/fhir/StructureDefinition/vector-search-config",
      "extension": [
        {
          "url": "sourceStrategy",
          "valueCode": "directText"
        },
        {
          "url": "extractionPolicy",
          "valueCode": "perValueRow"
        },
        {
          "url": "maxInputTokens",
          "valueInteger": 8000
        },
        {
          "url": "minimumScore",
          "valueDecimal": 0.0
        }
      ]
    }
  ]
}

###

# 3. Before reindex, this must not return semantic score/evidence for the new
# canonical. The server may ignore the unsupported code and still return the
# resource because the independent _id predicate matches.
GET {{baseUrl}}/Observation?_id={{putProofObservation.response.body.id}}&{{createProofSearchParameter.response.body.code}}=After%20standing%20in%20a%20warm%20crowded%20room%2C%20the%20patient%20developed%20tunnel%20vision%20and%20leg%20weakness%20but%20remained%20conscious.%20Symptoms%20resolved%20after%20lying%20flat.&_count=10
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# 4. Start asynchronous system reindex, scoped to Observation resources.
# Do not substitute POST /Observation/{id}/$reindex; that is a separate handler.
# @name startVectorReindex
POST {{baseUrl}}/$reindex
Content-Type: application/fhir+json
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

{
  "resourceType": "Parameters",
  "parameter": [
    {
      "name": "targetResourceTypes",
      "valueString": "Observation"
    },
    {
      "name": "maximumNumberOfResourcesPerQuery",
      "valueInteger": 100
    },
    {
      "name": "maximumNumberOfResourcesPerWrite",
      "valueInteger": 25
    }
  ]
}

###

# 5. Repeat until parameter[name=status].valueString is Completed.
# Failed or Canceled is a proof failure.
GET {{startVectorReindex.response.headers.Content-Location}}
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# 6. The same query must now return demo-reindex-proof-observation with score
# and semantic evidence.
GET {{baseUrl}}/Observation?_id={{putProofObservation.response.body.id}}&{{createProofSearchParameter.response.body.code}}=After%20standing%20in%20a%20warm%20crowded%20room%2C%20the%20patient%20developed%20tunnel%20vision%20and%20leg%20weakness%20but%20remained%20conscious.%20Symptoms%20resolved%20after%20lying%20flat.&_count=10
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# 7. Verify meta.versionId still equals the value returned by request 1.
# Reindex updates search storage, not the FHIR resource version.
GET {{baseUrl}}/Observation/{{putProofObservation.response.body.id}}
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# OPTIONAL CLEANUP: queue deletion of the proof resources, then run request 4
# and request 5 once more to finalize SearchParameter hard deletion.
DELETE {{baseUrl}}/Observation/{{putProofObservation.response.body.id}}
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

DELETE {{baseUrl}}/SearchParameter/{{createProofSearchParameter.response.body.id}}?hardDelete=true
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}