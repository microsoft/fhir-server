@baseUrl = https://localhost:44348

# @name bearer
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
&client_id=globalAdminServicePrincipal
&client_secret=globalAdminServicePrincipal
&scope=fhir-api

###

# Run from top to bottom. Every interaction is an idempotent PUT.
# Vector indexing runs synchronously during twenty clinical-owner writes:
# nine Elena Observations/DiagnosticReports, eight Elena DocumentReferences,
# and three control-patient owners across the same supported resource types.

PUT {{baseUrl}}/Practitioner/demo-practitioner-emergency
Content-Type: application/fhir+json
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

< ../resources/practitioners/demo-practitioner-emergency.json

