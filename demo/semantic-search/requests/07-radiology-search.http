@baseUrl = https://localhost:44348
@patientId = 8f789d0b-3145-4cf2-8504-13159edaa747

# @name bearer
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
&client_id=globalAdminServicePrincipal
&client_secret=globalAdminServicePrincipal
&scope=fhir-api

###

# Structured timeline: exactly three chest CT DiagnosticReports for Elena,
# ordered from baseline through the eighteen-month follow-up.
GET {{baseUrl}}/DiagnosticReport?patient={{patientId}}&category=RAD&code=http%3A%2F%2Floinc.org%7C24627-2&_sort=date&_count=20
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# Semantic timeline question. Expected direct evidence covers the initial
# recommendation, completed six-month exam, and long-term stability.
GET {{baseUrl}}/DiagnosticReport?patient={{patientId}}&code=http%3A%2F%2Floinc.org%7C24627-2&semantic-text=Was%20the%20lung%20nodule%20follow-up%20completed%2C%20and%20did%20the%20finding%20change%3F&_count=10
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# Varied wording check: later reports call the original nodule a focal opacity
# or focal density, so this query should not depend on exact keyword repetition.
GET {{baseUrl}}/DiagnosticReport?patient={{patientId}}&category=RAD&semantic-text=Did%20the%20right%20upper%20lobe%20finding%20grow%20on%20later%20imaging%3F&_count=10
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# Binary-backed report search. Evidence source paths must be Binary.data and
# owner resources must remain DocumentReference.
GET {{baseUrl}}/DocumentReference?patient={{patientId}}&type=http%3A%2F%2Floinc.org%7C18748-4&semantic-text=What%20follow-up%20did%20prior%20chest%20imaging%20recommend%3F&_count=10
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# Patient-wide MCP-equivalent route: no David Chen control resource may appear.
POST {{baseUrl}}/Patient/{{patientId}}/$semantic-search
Content-Type: application/fhir+json
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

{
  "resourceType": "Parameters",
  "parameter": [
    {
      "name": "query",
      "valueString": "Was the lung nodule follow-up completed, and did the finding change?"
    },
    {
      "name": "type",
      "valueCode": "DiagnosticReport"
    },
    {
      "name": "type",
      "valueCode": "DocumentReference"
    },
    {
      "name": "count",
      "valueInteger": 10
    }
  ]
}