@baseUrl = https://localhost:44348
@patientId = 8f789d0b-3145-4cf2-8504-13159edaa747

# @name bearer
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
&client_id=globalAdminServicePrincipal
&client_secret=globalAdminServicePrincipal
&scope=fhir-api

###

# LONG UTF-8 TEXT
# Expected first: DocumentReference/demo-doc-long-vestibular-text.
# The winning evidence should mention the right Dix-Hallpike or Epley maneuver.
# Expected source: Binary/demo-binary-long-vestibular-text/_history/{version}.
# Expected sourcePath: Binary.data.
GET {{baseUrl}}/DocumentReference?patient={{patientId}}&semantic-text=What%20caused%20the%20brief%20spinning%20when%20she%20rolled%20onto%20her%20right%20side%20in%20bed%2C%20and%20what%20maneuver%20improved%20it%3F&_count=5
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# PDF PAGE 1
# Expected first: DocumentReference/demo-doc-long-autonomic-pdf.
# The winning evidence should describe active-stand blood pressures or the binder.
# Expected sourcePath: Binary.data#page=1.
GET {{baseUrl}}/DocumentReference?patient={{patientId}}&semantic-text=What%20happened%20to%20her%20blood%20pressure%20and%20heart%20rate%20during%20active%20stand%20testing%2C%20and%20did%20an%20abdominal%20binder%20help%3F&_count=5
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# PDF PAGE 2
# Expected first: DocumentReference/demo-doc-long-autonomic-pdf.
# The strongest evidence should connect a hot shower, gray vision, and stopping
# hydrochlorothiazide. Expected sourcePath: Binary.data#page=2.
GET {{baseUrl}}/DocumentReference?patient={{patientId}}&semantic-text=What%20happened%20after%20the%20hot%20shower%2C%20and%20which%20medication%20was%20stopped%20to%20reduce%20future%20near-fainting%3F&_count=5
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# CROSS-FORMAT CLINICAL DISTINCTION
# Expected top tier: both new long documents. Their evidence should distinguish
# motion-triggered room spinning from upright gray vision and leg weakness.
GET {{baseUrl}}/DocumentReference?patient={{patientId}}&semantic-text=Which%20notes%20distinguish%20room%20spinning%20triggered%20by%20rolling%20in%20bed%20from%20gray%20vision%20and%20weakness%20while%20standing%3F&_count=5
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# NEGATIVE DISCRIMINATION CONTROL
# Expected first: DocumentReference/demo-doc-dermatology. Neither new long
# document should outrank it merely because it contains substantially more text.
GET {{baseUrl}}/DocumentReference?patient={{patientId}}&semantic-text=Which%20note%20discusses%20an%20itchy%20skin%20plaque%20and%20topical%20treatment%3F&_count=5
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}