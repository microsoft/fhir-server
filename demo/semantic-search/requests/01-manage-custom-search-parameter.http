@baseUrl = https://localhost:44348
@searchParameterCanonical = https://example.org/fhir/SearchParameter/demo-observation-semantic-text

# @name bearer
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
&client_id=globalAdminServicePrincipal
&client_secret=globalAdminServicePrincipal
&scope=fhir-api

###

# OPTIONAL CUSTOM SEARCHPARAMETER LIFECYCLE
#
# This file manages a custom definition. It does not replace or delete the
# built-in Microsoft semantic-text SearchParameters.
#
# Run conditional create, start reindex, wait for the job to complete, then verify.
# On schema 118, the activation reindex also generates vector rows for existing
# applicable resources. Later resource writes keep the custom index current.

# Conditionally create the custom vector SearchParameter through the FHIR API.
# If the canonical already exists, the server returns the existing definition.
# Change minimumScore here to tune query eligibility. Valid values are 0 through 1.
# @name createSearchParameter
POST {{baseUrl}}/SearchParameter
Content-Type: application/fhir+json
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}
If-None-Exist: url={{searchParameterCanonical}}

{
  "resourceType": "SearchParameter",
  "url": "https://example.org/fhir/SearchParameter/demo-observation-semantic-text",
  "version": "1.0.0",
  "name": "DemoObservationSemanticText",
  "status": "active",
  "experimental": true,
  "publisher": "Microsoft FHIR Server semantic search demo",
  "description": "Search Observation note text by semantic similarity with a configurable minimum score.",
  "code": "demo-semantic-text",
  "base": [
    "Observation"
  ],
  "type": "special",
  "expression": "Observation.note.text",
  "extension": [
    {
      "url": "http://microsoft.com/fhir/StructureDefinition/vector-search-config",
      "extension": [
        {
          "url": "sourceStrategy",
          "valueCode": "directText"
        },
        {
          "url": "extractionPolicy",
          "valueCode": "perValueRow"
        },
        {
          "url": "maxInputTokens",
          "valueInteger": 8000
        },
        {
          "url": "minimumScore",
          "valueDecimal": 0.65
        }
      ]
    }
  ]
}

###

# A newly created definition initially reports Supported and is not searchable.
GET {{baseUrl}}/SearchParameter/$status?url={{searchParameterCanonical}}
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# Promote Supported SearchParameters to Enabled/searchable.
# @name enableReindex
POST {{baseUrl}}/$reindex
Content-Type: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

{
  "resourceType": "Parameters",
  "parameter": [
    {
      "name": "maximumConcurrency",
      "valueInteger": 1
    },
    {
      "name": "maximumNumberOfResourcesPerQuery",
      "valueInteger": 100
    }
  ]
}

###

# Repeat this request until the reindex job reports completion.
GET {{enableReindex.response.headers.Content-Location}}
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# After the job completes, this definition should report Enabled/searchable.
GET {{baseUrl}}/SearchParameter/$status?url={{searchParameterCanonical}}
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# After activation and reindex completion, query the custom code.
GET {{baseUrl}}/Observation?patient=8f789d0b-3145-4cf2-8504-13159edaa747&demo-semantic-text=previous%20near-fainting%20episodes&_count=10
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

###

# OPTIONAL DISABLE
# This queues the custom definition for disabling. Run another $reindex job and
# wait for completion to finalize the Disabled status.
PUT {{baseUrl}}/SearchParameter/$status
Content-Type: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}

{
  "resourceType": "Parameters",
  "parameter": [
    {
      "name": "searchParameterStatus",
      "part": [
        {
          "name": "url",
          "valueUrl": "https://example.org/fhir/SearchParameter/demo-observation-semantic-text"
        },
        {
          "name": "status",
          "valueString": "Disabled"
        }
      ]
    }
  ]
}

###

# OPTIONAL HARD RESET
# Delete only this custom definition. Run another $reindex job and wait for it
# to finish the pending deletion before rerunning the conditional create request.
DELETE {{baseUrl}}/SearchParameter/{{createSearchParameter.response.body.id}}?hardDelete=true
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}
