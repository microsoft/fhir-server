@baseUrl = https://localhost:44348

# Local development identity provider only. These are test credentials defined
# in testauthenvironment.json, not Azure credentials.
# @name bearer
POST {{baseUrl}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
&client_id=globalAdminServicePrincipal
&client_secret=globalAdminServicePrincipal
&scope=fhir-api

###

# Expected: 200 FHIR CapabilityStatement.
# Confirm this is the SQL-backed R4 server prepared with schema 118 and vector
# configuration before continuing.
GET {{baseUrl}}/metadata
Accept: application/fhir+json
Authorization: Bearer {{bearer.response.body.access_token}}