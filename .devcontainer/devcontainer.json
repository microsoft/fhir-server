{
	"name": "FHIR SQL Server",
	"dockerComposeFile": "docker-compose.sql.yml",
	"service": "fhir-sql",
	"runServices": ["sql", "fhir-sql"],
	"workspaceFolder": "/workspace",
	"shutdownAction": "stopCompose",
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
	},
	"remoteEnv": {
		"LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csharp",
				"humao.rest-client"
			]
		}
	},
	"initializeCommand": [
		"docker", "run", "--rm",
		"--mount", "type=bind,source=${localWorkspaceFolder}/.devcontainer,target=/devcontainer",
		"mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
		"bash", "/devcontainer/initialize-sql.sh"
	],
	"postStartCommand": "/setup/post-start-sql.sh",
	"waitFor": "postStartCommand",
	"remoteUser": "vscode",
	"forwardPorts": [44348],
	"portsAttributes": {
		"44348": {
			"label": "FHIR HTTPS",
			"protocol": "https"
		}
	}
}
