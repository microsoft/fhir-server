<!--
  This project exists only so Dependabot can discover the repository's NuGet packages cheaply.

  Dependabot re-runs a full dependency discovery pass before every group in .github/dependabot.yml.
  Pointed at the repository root it walked all 78 projects each time, which cost roughly four
  minutes per group and pushed the job past GitHub's fixed 55 minute limit, so later groups -
  including the catch-all minor-and-patch group - never ran at all.

  .github/dependabot.yml points the nuget ecosystem at this directory instead. Discovery then
  resolves one project rather than 78, while Central Package Management keeps the versions in
  the repository root Directory.Packages.props as the single source of truth - which is still
  the file Dependabot edits.

  Rules:
    * Never add this project to Microsoft.Health.Fhir.sln. Dependabot walks upward from the
      configured directory to any solution that claims the project; being claimed would silently
      restore the slow whole-repository behaviour.
    * Keep the discovery TargetFramework aligned with a framework the Choose in
      Directory.Packages.props handles, since that is what selects AspNetPackageVersion. It lives
      in Directory.Build.props because Directory.Packages.props is imported before this file.
    * Keep the PackageReference list below in step with Directory.Packages.props.
    * Keep the nuget directory in .github/dependabot.yml pointing at this folder.

  The ValidateDependabotCoverage target at the bottom of this file checks every rule above. It
  only evaluates - no restore, no network - so this verifies the lot in about a second:

    dotnet msbuild build/DependabotDiscovery -t:ValidateDependabotCoverage
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework is deliberately set in Directory.Build.props; see the comment there. -->
    <!-- Never built, shipped or referenced; restore is the only operation that must succeed. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!--
      Collapsing every package into one project creates version conflicts that do not exist in the
      real projects, where these packages never meet. NU1605 (downgrade) is an error by default and
      would fail a project whose only job is to be listed; NU1510 fires for packages the framework
      already provides. Nothing else is suppressed - in particular NU1604 is left on, because an
      unbounded version range here means TargetFramework has stopped matching Directory.Packages.props.
    -->
    <NoWarn>$(NoWarn);NU1510;NU1605</NoWarn>
  </PropertyGroup>

  <!-- One bare entry per PackageVersion in Directory.Packages.props, which supplies the version. -->
