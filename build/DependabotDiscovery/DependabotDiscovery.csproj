  <!--
    Each of these is a way this project can stop doing its job without anyone noticing: a package
    silently dropping out of Dependabot's view, a version silently resolving to nothing, the
    solution silently reclaiming the whole-repository scan, or dependabot.yml silently pointing at
    a folder that no longer exists. They are checks rather than comments because every one of them
    was, at some point, only a comment.

    Nothing here needs a restore or a network, so it runs anywhere in about a second.
  -->
  <Target Name="ValidateDependabotCoverage" BeforeTargets="CollectPackageReferences">

    <PropertyGroup>
      <_RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../..'))</_RepoRoot>
      <_RelativeDir>$(MSBuildThisFileDirectory.Substring($(_RepoRoot.Length)).Replace('\','/').TrimEnd('/'))</_RelativeDir>
      <_SolutionFile>$(_RepoRoot)Microsoft.Health.Fhir.sln</_SolutionFile>
      <_DependabotConfig>$(_RepoRoot).github/dependabot.yml</_DependabotConfig>
    </PropertyGroup>

    <ItemGroup>
      <_UncoveredPackage Include="@(PackageVersion)" Exclude="@(PackageReference)" />
      <_UnexpectedPackage Include="@(PackageReference)" Exclude="@(PackageVersion)" />
      <_VersionlessPackage Include="@(PackageVersion)" Condition="'%(PackageVersion.Version)' == ''" />
    </ItemGroup>

    <!-- This list and Directory.Packages.props must describe the same set of packages. -->
    <Error Condition="'@(_UncoveredPackage)' != ''"
           Text="$(MSBuildProjectFile) is missing a PackageReference for: @(_UncoveredPackage, ', '). Dependabot will not update these packages until they are listed here." />
    <Error Condition="'@(_UnexpectedPackage)' != ''"
           Text="$(MSBuildProjectFile) references packages absent from Directory.Packages.props: @(_UnexpectedPackage, ', '). Remove them." />

    <!-- An empty version means TargetFramework no longer matches the Choose in Directory.Packages.props. -->
    <Error Condition="'$(TargetFramework)' == ''"
           Text="TargetFramework is empty, so Directory.Packages.props cannot select AspNetPackageVersion. It must be set in Directory.Build.props, not in $(MSBuildProjectFile) - see the comment there." />
    <Error Condition="'@(_VersionlessPackage)' != ''"
           Text="No version resolved for: @(_VersionlessPackage, ', '). TargetFramework '$(TargetFramework)' is not handled by the Choose in Directory.Packages.props, so Dependabot would see an unbounded range instead of a version." />

    <!-- Being claimed by the solution silently restores the slow whole-repository scan. -->
    <Error Condition="Exists('$(_SolutionFile)') AND $([System.IO.File]::ReadAllText('$(_SolutionFile)').Contains('DependabotDiscovery'))"
           Text="Microsoft.Health.Fhir.sln references this project. Dependabot walks up to the owning solution and would scan the whole repository again, reintroducing the job timeout this project exists to prevent. Remove it from the solution." />

    <!-- dependabot.yml has to point at wherever this project now lives. -->
    <Error Condition="Exists('$(_DependabotConfig)') AND !$([System.IO.File]::ReadAllText('$(_DependabotConfig)').Contains('directory: &quot;/$(_RelativeDir)&quot;'))"
           Text="No nuget entry in .github/dependabot.yml points at &quot;/$(_RelativeDir)&quot;. If this project moved, update the nuget directory to match - otherwise Dependabot finds no manifests here and stops updating NuGet packages altogether." />

  </Target>

</Project>
