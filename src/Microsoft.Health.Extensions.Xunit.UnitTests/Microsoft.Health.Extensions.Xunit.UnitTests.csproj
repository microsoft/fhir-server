<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The scenarios these tests assert on are only observable in a real xUnit run: the number of
      results published, the names they are published under, and whether a run reports anything at
      all. They therefore live in a separate assembly that this project launches as a child process,
      once per scenario, with the runner flags that scenario needs.
    -->
    <TestAssetsAssembly>$(MSBuildThisFileDirectory)..\Microsoft.Health.Extensions.Xunit.TestAssets\bin\$(Configuration)\$(TargetFramework)\Microsoft.Health.Extensions.Xunit.TestAssets.dll</TestAssetsAssembly>
    <!--
      The CI legs decide whether a retried failure really cleared by reading the reports the runner
      wrote, in this script. It is the only thing standing between a failure that turns into a skip
      and a green leg, so it is tested here rather than only in the pipeline that runs it.
    -->
    <RetryReconciliationScript>$(MSBuildThisFileDirectory)..\..\build\jobs\scripts\Assert-RetriedFailuresPassed.ps1</RetryReconciliationScript>
    <!--
      The unit test leg runs whatever its project glob matches, so a project leaving the glob is
      never run and nothing says so. This script and the list beside it are what notices.
    -->
    <UnitTestProjectsScript>$(MSBuildThisFileDirectory)..\..\build\jobs\scripts\Assert-UnitTestProjectsDiscovered.ps1</UnitTestProjectsScript>
    <UnitTestProjectManifest>$(MSBuildThisFileDirectory)..\..\build\jobs\scripts\UnitTestProjects.txt</UnitTestProjectManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Health.Extensions.Xunit\Microsoft.Health.Extensions.Xunit.csproj" />
    <!--
      ReferenceOutputAssembly is false because the assets are launched as a process, never linked
      against. The reference exists so the assets are built before these tests run, which is also
      the only thing that builds them: the assets project is deliberately absent from
      Microsoft.Health.Fhir.sln so that nothing discovers and runs its failing tests directly.
    -->
    <ProjectReference Include="..\Microsoft.Health.Extensions.Xunit.TestAssets\Microsoft.Health.Extensions.Xunit.TestAssets.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TestAssetsAssembly</_Parameter1>
      <_Parameter2>$(TestAssetsAssembly)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RetryReconciliationScript</_Parameter1>
      <_Parameter2>$(RetryReconciliationScript)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UnitTestProjectsScript</_Parameter1>
      <_Parameter2>$(UnitTestProjectsScript)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UnitTestProjectManifest</_Parameter1>
      <_Parameter2>$(UnitTestProjectManifest)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
