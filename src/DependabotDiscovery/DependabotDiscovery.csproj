  <!--
    A package missing from the list above is a package Dependabot stops updating, silently. This
    target turns that into a build failure rather than a slow drift into unpatched dependencies.
  -->
  <Target Name="ValidateDependabotCoverage" BeforeTargets="CollectPackageReferences">
    <ItemGroup>
      <_UncoveredPackage Include="@(PackageVersion)" Exclude="@(PackageReference)" />
      <_UnexpectedPackage Include="@(PackageReference)" Exclude="@(PackageVersion)" />
    </ItemGroup>
    <Error Condition="'@(_UncoveredPackage)' != ''"
           Text="$(MSBuildProjectFile) is missing a PackageReference for: @(_UncoveredPackage, ', '). Dependabot will not update these until they are added." />
    <Error Condition="'@(_UnexpectedPackage)' != ''"
           Text="$(MSBuildProjectFile) references packages absent from Directory.Packages.props: @(_UnexpectedPackage, ', '). Remove them." />
  </Target>

</Project>
